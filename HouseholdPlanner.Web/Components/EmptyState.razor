<MudStack AlignItems="AlignItems.Center" Spacing="1" Class="mx-8 my-10">
    <MudText Typo="Typo.h6">@Title</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Text</MudText>
</MudStack>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Text { get; set; }
}
