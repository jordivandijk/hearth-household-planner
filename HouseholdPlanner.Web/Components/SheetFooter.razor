@inject IStringLocalizer<Strings> T

<MudStack Row Spacing="2">
    @if (CanDelete)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Large" OnClick="OnDelete">@T["Common_Delete"]</MudButton>
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth DropShadow="false"
               Disabled="!CanSave" OnClick="OnSave">@SaveLabel</MudButton>
</MudStack>

@code {
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool CanSave { get; set; }
    [Parameter, EditorRequired] public string SaveLabel { get; set; } = "";
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
}
