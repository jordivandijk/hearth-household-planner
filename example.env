# Copy to .env next to docker-compose.yml and fill in the values: cp example.env .env
# The .env file is git-ignored; never commit the real one.

# Database password, used by both Postgres and the API.
POSTGRES_PASSWORD=change-me

# Signs the login tokens. At least 32 random bytes: openssl rand -base64 32
# Changing it later signs everyone out.
JWT_KEY=

# The first admin account and its household, created on the first start only
# (while there is no admin yet). Change the password after signing in.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change-me
HOUSEHOLD_NAME=Home

# Public URL of the web app, for CORS. No trailing slash.
WEB_URL=https://household.example.com

# Where the app finds the API. Leave it empty when the API is on the same domain
# under /api/ (one reverse proxy for both). Otherwise e.g. http://192.168.1.10:5160
API_URL=

# Image tag to run: stable is what the Gitea workflow pushes from main.
TAG=stable
